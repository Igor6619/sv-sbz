# DATABASE
POSTGRES_PORT=5732
POSTGRES_DB=sbz-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@host.docker.internal:${POSTGRES_PORT}/${POSTGRES_DB}

# SETTING PATH
SERVICE_SETTING_PATH=/etc/setting.json
STORAGE_FILES_PATH=../.runtime/files

# REMOTE SERVICES
AUTH_SERVICE_URL=http://host.docker.internal:8080/api/auth
EVENTS_SERVICE_URL=http://host.docker.internal:8080/api/events
